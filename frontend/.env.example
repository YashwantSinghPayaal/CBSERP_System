# CBSERP Frontend Environment Variables
# For local development with Vite proxy, leave empty or set to http://localhost:5000/api
# When deploying to Vercel, set this to your backend Vercel URL (e.g., https://cbserp-backend.vercel.app/api)
VITE_API_URL=https://cbserp-backend.vercel.app/api

# Base routing path (leave as / for Vercel or custom domain)
VITE_BASE_PATH=/
