# CBSERP Backend Environment Variables

PORT=5000

# Local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/cbserp_db

# MongoDB Atlas (Free Tier):
# If you already have an existing Atlas cluster hosting another project, you can use the SAME cluster!
# Simply append `/cbserp_db` before the query params (`?retryWrites=true&w=majority`).
# Atlas will automatically create a separate, isolated database for CBSERP without affecting your existing project.
MONGO_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/cbserp_db?retryWrites=true&w=majority

# Secret key for signing JWT auth tokens
JWT_SECRET=cbserp_super_secret_jwt_key_2026
